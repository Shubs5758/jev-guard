# jevguard configuration. Copy to .env (which is git-ignored) and edit.
# Precedence: real environment variables > .env > policy.yaml > defaults.
# jevguard loads the nearest .env walking up from the working directory;
# set JEVGUARD_ENV_FILE to point somewhere else, or JEVGUARD_NO_DOTENV=1 to disable it.

# --- the Jev API key ------------------------------------------------------------------
# The policy only stores the NAME of this variable, never the key itself.
TYPESAFE_API_KEY=your-typesafe-api-key-here

# --- going through a gateway or proxy ---------------------------------------------------
# The endpoint must speak Jev's System One schema (see README).
# Vercel AI Gateway (verified):
# AI_GATEWAY_API_KEY=vck_...
# JEVGUARD_JEV_API_KEY_ENV=AI_GATEWAY_API_KEY
# JEVGUARD_JEV_BASE_URL=https://ai-gateway.vercel.sh/typesafe/v1/systemone
# JEVGUARD_JEV_MODEL=typesafe-ai/jev
# JEVGUARD_JEV_HEADERS=x-my-route=typesafe/jev,x-team=platform
# JEVGUARD_JEV_TIMEOUT_S=3.0
# JEVGUARD_JEV_CACHE_TTL_S=300
# JEVGUARD_JEV_RATE_LIMIT_COOLDOWN_S=60
# JEVGUARD_JEV_CIRCUIT_FAILURES=5

# auto = the real API when the key is set, otherwise the offline simulator.
# api | simulated | off are the explicit choices.
# JEVGUARD_JEV_BACKEND=auto

# --- how strict to be -------------------------------------------------------------------
# shadow = record every decision but never block. Use it for the first rollout.
# JEVGUARD_POLICY_NAME=production
JEVGUARD_MODE=enforce
# closed = block anything suspicious when Jev is unreachable; open = let it through flagged.
JEVGUARD_FAIL_MODE=closed
# JEVGUARD_SCOPE=customer support for Acme's billing product
# JEVGUARD_CANARIES=CANARY-3f9a
# JEVGUARD_REDACT_LOGGED_TEXT=true

# Thresholds per stage: <stage> is INPUT, TOOL_CALL, TOOL_RESULT, RETRIEVAL or OUTPUT.
# JEVGUARD_INPUT_BLOCK=0.85
# JEVGUARD_INPUT_FLAG=0.5
# JEVGUARD_INPUT_PII=redact
# JEVGUARD_OUTPUT_BLOCK=0.8
# JEVGUARD_TOOL_CALL_BLOCK=0.8
# JEVGUARD_INPUT_CHECKS=prompt_injection,jailbreak,harmful_request

# --- tool governance ---------------------------------------------------------------------
# JEVGUARD_TOOLS_DENY=delete_database,drop_table
# JEVGUARD_TOOLS_REQUIRE_APPROVAL=issue_refund,send_email,transfer_funds
# JEVGUARD_TOOLS_ALLOW=
# JEVGUARD_TOOLS_EGRESS_ALLOWLIST=api.acme.example,api.stripe.com

# --- sessions and approvals ----------------------------------------------------------------
# JEVGUARD_SESSION_MAX_TOOL_CALLS=60
# JEVGUARD_SESSION_MAX_IDENTICAL_TOOL_CALLS=4
# JEVGUARD_SESSION_ESCALATE_AT=2.2
# JEVGUARD_SESSION_BLOCK_AT=3.5
# JEVGUARD_APPROVALS_DEFAULT=block
# JEVGUARD_APPROVALS_TIMEOUT_S=120

# --- dashboard / server ----------------------------------------------------------------------
# JEVGUARD_DB=jevguard.db
# JEVGUARD_POLICY=policies/strict.yaml
# Require Authorization: Bearer <key> on /api/events, /api/guard and /api/approvals.
# JEVGUARD_API_KEY=
