include README.md
include LICENSE
include CHANGELOG.md
include CONTRIBUTING.md
include .env.example
include jevguard/py.typed

recursive-include jevguard/server/static *
recursive-include jevguard/evals/datasets *.jsonl
recursive-include policies *.yaml
recursive-include examples *.py
recursive-include clients *.mjs
recursive-include tests *.py

exclude jevguard.db
global-exclude __pycache__/*
global-exclude *.py[cod]
global-exclude .env
